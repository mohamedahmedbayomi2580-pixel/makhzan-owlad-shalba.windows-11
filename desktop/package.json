{
  "name": "makhzan-owlad-shalba-windows",
  "version": "1.0.0",
  "private": true,
  "description": "مخزن ولاد شلبه - Windows Desktop App",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.owladshalba.makhzan.windows",
    "productName": "مخزن ولاد شلبه",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "app/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Makhzan-Owlad-Shalba-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
